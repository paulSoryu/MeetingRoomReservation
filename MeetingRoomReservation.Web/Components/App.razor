<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MeetingRoomReservation.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeServer" />
</head>

<body>
    <Routes @rendermode="RenderModeServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

@code {
    // Prerendering disabled: [Authorize] must only be evaluated inside the interactive
    // circuit via our own AuthenticationStateProvider (JWT held in a scoped service), never
    // during the static-SSR HTTP pass, which would need a real ASP.NET Core auth scheme
    // registered via AddAuthentication() - something this app deliberately has none of.
    private static readonly IComponentRenderMode RenderModeServer = new InteractiveServerRenderMode(prerender: false);
}
