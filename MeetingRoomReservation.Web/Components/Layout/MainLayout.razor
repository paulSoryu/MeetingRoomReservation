@inherits LayoutComponentBase
@inject AuthTokenProvider TokenProvider
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">Meeting Rooms</a>
        <div class="navbar-nav me-auto flex-row gap-3">
            <a class="nav-link" href="/">Resources</a>
            <AuthorizeView>
                <Authorized>
                    <a class="nav-link" href="/my-bookings">My Bookings</a>
                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <a class="nav-link" href="/admin/resources">Manage Resources</a>
                    </AuthorizeView>
                </Authorized>
            </AuthorizeView>
        </div>
        <AuthorizeView>
            <Authorized>
                <span class="navbar-text text-light me-3">@context.User.Identity?.Name</span>
                <button class="btn btn-outline-light btn-sm" @onclick="Logout">Log out</button>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-outline-light btn-sm" href="/login">Log in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<div class="container pb-5">
    @Body
</div>

<div id="blazor-error-ui" class="alert alert-danger position-fixed bottom-0 start-50 translate-middle-x mb-3 shadow" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="alert-link">Reload</a>
    <span class="dismiss" role="button">🗙</span>
</div>

@code {
    private void Logout()
    {
        TokenProvider.Clear();
        Navigation.NavigateTo("/login");
    }
}
