@page "/admin/resources"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient ApiClient

<PageTitle>Manage Resources</PageTitle>

<h1 class="mb-4">Manage Resources</h1>

<div class="table-responsive mb-4">
    <table class="table table-striped align-middle">
        <thead><tr><th>Name</th><th>Working Hours</th><th>Slot Duration</th><th></th></tr></thead>
        <tbody>
            @if (_resources is not null)
            {
                @foreach (var resource in _resources)
                {
                    <tr>
                        <td>@resource.Name</td>
                        <td>@resource.WorkingHoursStart-@resource.WorkingHoursEnd</td>
                        <td>@resource.SlotDuration</td>
                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(resource.Id)">Delete</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="card col-12 col-md-6">
    <div class="card-body">
        <h2 class="h5 card-title">Add Resource</h2>
        <EditForm Model="_newResource" OnValidSubmit="CreateAsync">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="_newResource.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Start (HH:mm)</label>
                <InputText class="form-control" @bind-Value="_newResource.Start" />
            </div>
            <div class="mb-3">
                <label class="form-label">End (HH:mm)</label>
                <InputText class="form-control" @bind-Value="_newResource.End" />
            </div>
            <div class="mb-3">
                <label class="form-label">Slot minutes</label>
                <InputNumber class="form-control" @bind-Value="_newResource.SlotMinutes" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@code {
    private IReadOnlyList<ResourceDto>? _resources;
    private readonly NewResourceModel _newResource = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _resources = await ApiClient.GetResourcesAsync();

    private async Task CreateAsync()
    {
        _error = null;
        if (!TimeOnly.TryParse(_newResource.Start, out var start) || !TimeOnly.TryParse(_newResource.End, out var end))
        {
            _error = "Invalid time format - use HH:mm.";
            return;
        }

        var request = new CreateResourceRequest(_newResource.Name, start, end, TimeSpan.FromMinutes(_newResource.SlotMinutes));
        var response = await ApiClient.CreateResourceAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            _error = "Failed to create resource.";
            return;
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteResourceAsync(id);
        await LoadAsync();
    }

    private sealed class NewResourceModel
    {
        public string Name { get; set; } = "";
        public string Start { get; set; } = "09:00";
        public string End { get; set; } = "17:00";
        public int SlotMinutes { get; set; } = 30;
    }
}
