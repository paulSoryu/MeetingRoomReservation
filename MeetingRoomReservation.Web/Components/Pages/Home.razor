@page "/"
@attribute [Authorize]
@inject ApiClient ApiClient

<PageTitle>Resources</PageTitle>

<h1 class="mb-4">Meeting Rooms</h1>

@if (_resources is null)
{
    <p class="text-muted">Loading...</p>
}
else if (_resources.Count == 0)
{
    <p class="text-muted">No resources available.</p>
}
else
{
    <div class="list-group">
        @foreach (var resource in _resources)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               href="@($"schedule/{resource.Id}")">
                <span class="fw-semibold">@resource.Name</span>
                <span class="text-muted small">
                    @resource.WorkingHoursStart-@resource.WorkingHoursEnd
                    <span class="badge text-bg-secondary ms-2">@resource.SlotDuration.TotalMinutes min slots</span>
                </span>
            </a>
        }
    </div>
}

@code {
    private IReadOnlyList<ResourceDto>? _resources;

    protected override async Task OnInitializedAsync()
    {
        _resources = await ApiClient.GetResourcesAsync();
    }
}
